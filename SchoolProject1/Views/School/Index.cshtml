@model IEnumerable<SchoolProject1.ViewModels.School.SchoolIndexViewModel>

@{
    ViewData["Title"] = "Училища";
}

<h1>Списък с училища</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Добави ново училище
    </a>

    <a asp-controller="Student"
       asp-action="Index"
       class="btn btn-secondary">
        Виж учениците
    </a>
</p>

<table class="table table-striped table-bordered">

    <thead>
        <tr>
            <th>№</th>
            <th>Име на училището</th>
            <th>Адрес</th>
            <th>Брой ученици</th>
            <th>Имейл</th>
            <th>Телефон</th>
            <th>Брой стаи</th>
            <th>Действия</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.SchoolAddress</td>
                <td>@item.StudentsCount</td>
                <td>@item.Email</td>
                <td>@item.PhoneNumber</td>
                <td>@item.RoomsCount</td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">
                        Редактирай
                    </a>

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-info btn-sm">
                        Детайли
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm">
                        Изтрий
                    </a>
                </td>
            </tr>
        }
    </tbody>

</table>