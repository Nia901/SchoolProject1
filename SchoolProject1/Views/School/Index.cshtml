@model IEnumerable<SchoolProject1.ViewModels.School.SchoolIndexViewModel>

@{
    ViewData["Title"] = "Училища";
}

<h1>Списък с училища</h1>
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}
<p>
    <a asp-action="Create" class="btn btn-primary">
        Добави ново училище
    </a>

    <a asp-controller="Student"
       asp-action="Index"
       class="btn btn-secondary">
        Виж учениците
    </a>

    <a asp-controller="Teacher"
       asp-action="Index"
       class="btn btn-secondary">
        Виж учителите
    </a>
</p>
<form asp-controller="School" asp-action="Index" method="get">
    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label">Име на училище</label>

            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Търси по име..." />
        </div>

        <div class="col-md-3">
            <label class="form-label">Минимален брой ученици</label>
            <input type="number"
                   name="minStudents"
                   value="@ViewBag.MinStudents"
                   min="0"
                   class="form-control" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Сортирай по</label>
            <select name="sortOrder" class="form-control">
                <option value="name"
                        selected="@(ViewBag.SortOrder == "name")">
                    Име
                </option>

                <option value="students_asc"
                        selected="@(ViewBag.SortOrder == "students_asc")">
                    Брой учeници възходящо
                </option>

                <option value="students_desc"
                        selected="@(ViewBag.SortOrder == "students_desc")">
                    Брой ученици низходящо
                </option>
            </select>
        </div>

    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary">
            Търси
        </button>
    </div>
</form>
<table class="table table-striped table-bordered">

    <thead>
        <tr>
            <th>№</th>
            <th>Име на училището</th>
            <th>Адрес</th>
            <th>Брой ученици</th>
            <th>Имейл</th>
            <th>Телефон</th>
            <th>Брой стаи</th>
            <th>Действия</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.SchoolAddress</td>
                <td>@item.StudentsCount</td>
                <td>@item.Email</td>
                <td>@item.PhoneNumber</td>
                <td>@item.RoomsCount</td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">
                        Редактирай
                    </a>

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-info btn-sm">
                        Детайли
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm">
                        Изтрий
                    </a>
                </td>
            </tr>
        }
    </tbody>

</table>