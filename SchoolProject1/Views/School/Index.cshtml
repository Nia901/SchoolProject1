@model IEnumerable<SchoolProject1.ViewModels.School.SchoolIndexViewModel>
@{
    ViewData["Title"] = "Index";
}

<h1>Schools</h1>


<p>
    <a asp-action="Create">Create New School</a> |
    <a asp-controller="Student"
       asp-action="Index">
        View Students
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SchoolAddress)
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SchoolAddress)
                </td>
                <td>
                    <a asp-controller="School" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-controller="School" asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-controller="School" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>


