@model SchoolProject1.ViewModels.School.SchoolEditViewModel

<h1>Редактиране на училище</h1>

<form asp-action="Edit" method="post">

    <input asp-for="Id" type="hidden" />

    <label>Име:</label>
    <input asp-for="Name" />
    <span asp-validation-for="Name"></span>

    <br />
    <br />

    <label>Адрес:</label>
    <input asp-for="SchoolAddress" />
    <span asp-validation-for="SchoolAddress"></span>

    <br />
    <br />

    <button type="submit">Запази промените</button>

</form>

<br />

<a asp-action="Index">Назад към списъка</a>
