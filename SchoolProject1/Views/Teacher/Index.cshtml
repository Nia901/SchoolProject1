@model IEnumerable<SchoolProject1.ViewModels.Teacher.TeacherIndexViewModel>

@{
    ViewData["Title"] = "Учители";
}

<h1>Списък с учители</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Добави нов учител
    </a>
</p>
<div class="row mb-3">
    <div class="col-md-3">
        <label>Teacher Name</label>
        <input type="text" id="name"
               class="form-control"
               placeholder="Search by name..." />
    </div>

    <div class="col-md-3">
        <label>Subject</label>
        <input type="text" id="subject"
               class="form-control"
               placeholder="Enter subject..." />

    </div>
    <div class="col-md-3">
        <label>Sort by</label>
        <select id="sortOrder" class="form-control">
            <option value="name-asc">Name A-Z</option>
            <option value="name-desc">Name Z-A</option>
            <option value="subject">Subject A-Z</option>
        </select>
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <button type="button" id="clearFilters"
                class="btn btn-secondary">
            Clear Filters
        </button>
    </div>
</div>

<table class="table table-striped table-bordered">

    <thead>
        <tr>
            <th>№</th>
            <th>Име</th>
            <th>Фамилия</th>
            <th>Възраст</th>
            <th>Адрес</th>
            <th>Имейл</th>
            <th>Телефон</th>
            <th>Предмет</th>
            <th>Училище</th>
            <th>Действия</th>
        </tr>
    </thead>

    <tbody id="teachersTable">

        @foreach (var teacher in Model)
        {
            <tr>
                <td>@teacher.Id</td>
                <td>@teacher.FirstName</td>
                <td>@teacher.LastName</td>
                <td>@teacher.Age</td>
                <td>@teacher.Address</td>
                <td>@teacher.Email</td>
                <td>@teacher.PhoneNumber</td>
                <td>@teacher.Subject</td>
                <td>@teacher.SchoolName</td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@teacher.Id"
                       class="btn btn-warning btn-sm">
                        Редактирай
                    </a>

                    <a asp-action="Details"
                       asp-route-id="@teacher.Id"
                       class="btn btn-info btn-sm">
                        Детайли
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@teacher.Id"
                       class="btn btn-danger btn-sm">
                        Изтрий
                    </a>
                </td>
            </tr>
        }

    </tbody>

</table>

<br />

<a asp-controller="School" asp-action="Index" class="btn btn-secondary">
    Виж училищата
</a>

<a asp-controller="Student" asp-action="Index" class="btn btn-secondary">
    Виж учениците
</a>

@section Scripts {
    <script src="~/js/TeacherFile.js"
            asp-append-version="true"></script>
}