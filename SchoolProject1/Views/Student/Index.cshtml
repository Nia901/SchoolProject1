@model IEnumerable<SchoolProject1.ViewModels.Student.StudentIndexViewModel>

@{
    ViewData["Title"] = "Ученици";
}

<h1>Списък с ученици</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Добави нов ученик
    </a>
</p>
<table class="table table-striped table-bordered">

    <thead>
        <tr>
            <th>№</th>
            <th>Име</th>
            <th>Фамилия</th>
            <th>Възраст</th>
            <th>Действия</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var student in Model)
        {
            <tr>
                <td>
                    @student.Id
                </td>

                <td>
                    @student.FirstName
                </td>

                <td>
                    @student.LastName
                </td>

                <td>
                    @student.Age
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@student.Id"
                       class="btn btn-warning btn-sm">
                        Редактирай
                    </a>

                    <a asp-action="Details"
                       asp-route-id="@student.Id"
                       class="btn btn-info btn-sm">
                        Детайли
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@student.Id"
                       class="btn btn-danger btn-sm">
                        Изтрий
                    </a>
                </td>
            </tr>
        }

    </tbody>

</table>

<br />

<a asp-controller="School" asp-action="Index" class="btn btn-secondary">
    Виж училищата
</a></a>
