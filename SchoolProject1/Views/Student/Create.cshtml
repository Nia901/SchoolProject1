@model SchoolProject1.ViewModels.Student.StudentCreateViewModel

@{
    ViewData["Title"] = "Добавяне на ученик";
}

<h1>Добавяне на ученик</h1>

<h4>Ученик</h4>
<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <div class="form-group mb-3">
                <label asp-for="FirstName" class="control-label">
                    Име
                </label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="LastName" class="control-label">
                    Фамилия
                </label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Age" class="control-label">
                    Възраст
                </label>
                <input asp-for="Age" class="form-control" />
                <span asp-validation-for="Age" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Address" class="control-label">
                    Адрес
                </label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
                <small class="form-text text-muted">
                    Адресът трябва да съдържа име на град.
                </small>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label">
                    Имейл
                </label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PhoneNumber" class="control-label">
                    Телефон
                </label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TeacherIds" class="control-label">
                    Избери учители
                </label>

                <select asp-for="TeacherIds"
                        asp-items="ViewBag.Teachers"
                        class="form-control"
                        multiple>
                </select>

                <span asp-validation-for="TeacherIds" class="text-danger"></span>

                <small class="form-text text-muted">
                    Можеш да избереш повече от един учител.
                    За няколко избора задръж Ctrl (Windows).
                </small>
            </div>

            <br />

            <div class="form-group">
                <button type="submit" class="btn btn-primary">
                    Запази
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Назад към списъка
                </a>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}